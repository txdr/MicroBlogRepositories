@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<h1>MicroBlog</h1>
@if (Model.Posts.Count == 0)
{
    <p>No posts yet. <a asp-page="/Create">Create the first one!</a></p>
} else
{
    <section>
        @foreach (var post in Model.Posts)
        {
            <partial name="_PostCard" model="post" />
            
        }
    </section>
}