@model MicroBlog.Models.Post
<article class="post-card">
	<header class="post-card__header">
		<h2 class="post-card__title">
			<a asp-page="/Details" asp-route-id="@Model.Id">@Model.Title</a>
		</h2>
		<small class="post-card__date">@Model.CreatedUTC.ToLocalTime()</small>
	</header>
	<p class="post-card__excerpt">
		@((Model.Body?.Length ?? 0) > 160 ? Model.Body.Substring(0, 160) + "..." : Model.Body)
	</p>
	<a class="post-card__more" asp-page="/Details" asp-route-id="@Model.Id">Read More</a>
	<hr />
</article>
